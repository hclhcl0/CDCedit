# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=cdcai
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/jub0t/Concat"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/cdcai" "$pkgdir/opt/cdcai/cdcai"
  install -d "$pkgdir/opt/cdcai/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/cdcai/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/cdcai/cdcai "$@"\n' > "$pkgdir/usr/bin/cdcai"
  chmod 755 "$pkgdir/usr/bin/cdcai"
  install -Dm644 "$stage/cdcai.desktop" "$pkgdir/usr/share/applications/cdcai.desktop"
  sed -i 's|^Exec=cdcai|Exec=/opt/cdcai/cdcai %U|' "$pkgdir/usr/share/applications/cdcai.desktop"
  install -Dm644 "$stage/cdcai.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/cdcai.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/cdcai/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/cdcai/THIRD_PARTY_NOTICES.md"
}
