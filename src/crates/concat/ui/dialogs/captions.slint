import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, CopyChip, Field, DialogRow, DialogSection, Modal, Progress } from "../primitives/modal.slint";
import { SegmentedControl } from "../primitives/segmented-control.slint";
import { Select } from "../primitives/select.slint";
import { PaneScroll } from "../workspace/pane.slint";
import { Switch, ColourField } from "../inspector/controls.slint";

// Captions: what the tray's Captions tool opens.
//
// Two sheets in one, and a switch between them: "Use Sample Voice".
// On, the words are a clip's: one picked from the timeline's clips that
// have sound, through the transcriber, cut to the words' own timing. Off,
// they are a script typed here, one title per sentence at reading pace,
// laid down from the playhead. The list holds only clips with sound, so a
// silent video cannot be sent to the transcriber. The switch starts on
// when the sheet is opened on a clip with sound - from the clip's menu, or
// with one selected - and off otherwise. Then where the lines sit and how
// big they are, and one button. While it runs
// the sheet is the progress report: a transcription knows how far through
// the sound it is, so it gets a real bar and not a sweep. The language is
// the transcriber's to work out.
//
// On a desk it is a card floating over the editor (see Modal.floating): the
// timeline stays live under it, so the clip it transcribes follows the
// selection - a clip with sound selected is the one shown and run. Closed,
// a transcription goes on, and opened again the card shows it. On a phone
// it is a sheet.

export struct CaptionReviewRow { original: string, reason: string, options: [string], choice: int }
export struct CaptionsSheetData {
    open: bool,
    /// "Use Sample Voice": the words come from a clip's sound.
    from-voice: bool,
    /// The timeline's clips with sound, by file and start.
    sources: [string],
    /// Row in `sources` of the clip to transcribe; -1 for none.
    source: int,
    text: string,
    /// Row in the installed transcriber list.
    model: int,
    provider: int,
    gemini-language: int,
    gemini-proofread: bool,
    gemini-smart-split: bool,
    gemini-two-speakers: bool,
    speaker2-color: color,
    glossary: string,
    reviewing: bool,
    reviews: [CaptionReviewRow],
    /// 0 Bottom, 1 Centre, 2 Top
    placement: int,
    /// 0 Small, 1 Medium, 2 Large
    size: int,
    text-color: color,
    stroke-choice: int,
    stroke-color: color,
    running: bool,
    /// 0..1: where the transcription surely is.
    progress: float,
    /// Where the step under way leaves the bar, 0..1.
    ceiling: float,
    /// Seconds that step should take.
    step: float,
    /// Seconds of the run still to go, once the work has been timed;
    /// negative before.
    left: float,
    /// What the run is doing, in words.
    stage: string,
    /// A transcriber model is installed.
    ready: bool,
    /// Why the last run failed, when it did.
    message: string,
}

export component CaptionsDialog inherits Modal {
    in property <CaptionsSheetData> data;
    /// The installed transcriber models, by name.
    in property <[string]> models;

    callback voice-toggled(on: bool);
    callback source-changed(index: int);
    callback text-edited(text: string);
    callback model-changed(index: int);
    callback provider-changed(index: int);
    callback configure-api();
    callback gemini-language-changed(index: int);
    callback gemini-proofread-toggled(on: bool);
    callback gemini-smart-split-toggled(on: bool);
    callback gemini-two-speakers-toggled(on: bool);
    callback speaker2-color-changed(color: color);
    callback glossary-edited(text: string);
    callback review-choice(index: int, choice: int);
    callback review-apply(use-choices: bool);
    callback placement-changed(index: int);
    callback size-changed(index: int);
    callback text-color-changed(color: color);
    callback stroke-choice-changed(index: int);
    callback stroke-color-changed(color: color);
    callback begin();
    callback cancel();
    callback import-srt();
    callback export-srt();
    callback wrap-existing();

    property <bool> from-voice: root.data.from-voice;

    open: root.data.open;
    title: I18n.t("captions.captions");
    glyph: Glyph.text-mark;
    surface-width: 480px;
    dismissable: !root.data.running;

    // The script being typed, held apart from `data.text` the way the Field
    // primitive holds its draft: a TextInput's binding is dropped on the
    // first keystroke, so the sheet re-seeds it when it opens and never
    // while it is being typed into.
    property <string> draft;
    /// The script has the caret. Kept up here because the box lives under
    /// an `if`, and nothing outside one can reach into it.
    property <bool> typing;
    changed data => {
        if (!root.typing) {
            root.draft = root.data.text;
        }
    }
    init => { root.draft = root.data.text; }

    VerticalLayout {
        if root.data.reviewing: VerticalLayout {
            spacing: 8px;
            Text { text: "Duyệt đề xuất sửa từ nhận dạng sai"; color: Theme.fg; font-size: Theme.fs; wrap: word-wrap; }
            Text { text: "AI suy đoán từ văn bản, chưa nghe lại âm thanh. Mặc định giữ nguyên; chọn phương án phù hợp cho từng câu."; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
            PaneScroll {
                height: 340px;
                finger: true;
                VerticalLayout {
                    spacing: 12px;
                    for row[index] in root.data.reviews: VerticalLayout {
                        spacing: 6px;
                        Text { text: row.original; color: Theme.fg; font-size: Theme.fs; wrap: word-wrap; }
                        Text { text: row.reason; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
                        Select { options: row.options; current: row.choice; changed(choice) => { root.review-choice(index, choice); } }
                    }
                }
            }
            Button { label: "Áp dụng các lựa chọn"; primary: true; block: true; clicked => { root.review-apply(true); } }
            Button { label: "Giữ nguyên toàn bộ"; block: true; clicked => { root.review-apply(false); } }
        }
        if !root.data.reviewing: Flickable {
            property <length> max-body-h: Math.max(180px, root.height - root.inset-top - root.inset-bottom - (root.fill ? 50px : 66px));
            height: Math.min(captions-form.preferred-height, self.max-body-h);
            content-width: self.width;
            content-height: captions-form.preferred-height;
            interactive: captions-form.preferred-height > self.height;

            captions-form := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: self.preferred-height;
            if !root.data.running && !root.from-voice: DialogSection {
                first: true;
                title: I18n.t("common.script");

                Rectangle {
                    height: 104px;
                    border-radius: Theme.r;
                    background: Theme.well;
                    border-width: 1px;
                    border-color: script.has-focus ? Theme.accent : Theme.line;
                    clip: true;

                    script := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        text <=> root.draft;
                        color: Theme.fg;
                        font-size: Theme.fs-lg;
                        single-line: false;
                        wrap: word-wrap;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;
                        changed has-focus => { root.typing = self.has-focus; }
                        edited => { root.text-edited(self.text); }
                        // Home and End are unbound in Slint on macOS and would
                        // walk up to the window's playhead shortcuts.
                        key-pressed(event) => {
                            if (event.text == Key.Home) {
                                self.set-selection-offsets(0, 0);
                                return accept;
                            }
                            if (event.text == Key.End) {
                                self.set-selection-offsets(1000000000, 1000000000);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    if root.draft == "" && !script.has-focus: Text {
                        x: 10px;
                        y: 8px;
                        text: I18n.t("captions.typeWordsPutScreen");
                        color: Theme.fg-dim;
                        font-size: Theme.fs-lg;
                    }
                }
            }

            // The switch, under the script it stands in for: off, the words
            // are typed above it; on, they come from a clip's voice, chosen
            // under it. A row of its own rather than a DialogRow, whose label
            // column is too narrow for the words.
            if !root.data.running: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("captions.transcribeClipVoice");
                    color: Theme.fg;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.from-voice;
                        toggled(on) => { root.voice-toggled(on); }
                    }
                }
            }

            if !root.data.running && root.from-voice: DialogSection {
                first: true;
                title: I18n.t("common.transcriber");

                DialogRow {
                    label: I18n.t("common.audio");
                    HorizontalLayout {
                        spacing: 8px;
                        Select {
                            horizontal-stretch: 1;
                            options: root.data.sources;
                            current: root.data.source;
                            placeholder: I18n.t("captions.noVoiceOnTimeline");
                            enabled: root.data.sources.length > 0;
                            changed(index) => { root.source-changed(index); }
                        }
                        Button {
                            label: "Duyệt…";
                            glyph: Glyph.folder;
                            ghost: true;
                            clicked => { root.source-changed(-2); }
                        }
                    }
                }

                DialogRow {
                    label: I18n.t("captions.provider");
                    Select {
                        options: ["Whisper", "Gemini 3.5 Transcribe"];
                        current: root.data.provider;
                        changed(index) => { root.provider-changed(index); }
                    }
                }
                if root.data.provider == 1: Button {
                    label: I18n.t("settings.configureApi");
                    clicked => { root.configure-api(); }
                }
                DialogRow {
                    label: I18n.t("settings.language");
                    Select {
                        options: ["Tiếng Việt", I18n.t("captions.autoLanguage")];
                        current: root.data.gemini-language;
                        changed(index) => { root.gemini-language-changed(index); }
                    }
                }
                if root.data.provider == 1: Text {
                    text: I18n.t("captions.geminiNotice");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                if root.data.provider == 1: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.t("captions.geminiSmartSplit");
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: root.data.gemini-smart-split;
                            toggled(on) => { root.gemini-smart-split-toggled(on); }
                        }
                    }
                }
                if root.data.provider == 1 && root.data.gemini-smart-split: Text {
                    text: I18n.t("captions.geminiSmartSplitNotice");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                if root.data.provider == 1: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.t("captions.geminiTwoSpeakers");
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: root.data.gemini-two-speakers;
                            toggled(on) => { root.gemini-two-speakers-toggled(on); }
                        }
                    }
                }
                if root.data.provider == 1 && root.data.gemini-two-speakers: Text {
                    text: I18n.t("captions.geminiTwoSpeakersNotice");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                if root.data.provider == 0: DialogRow {
                    label: I18n.t("common.model");
                    Select {
                        options: root.models;
                        current: root.data.model;
                        placeholder: I18n.t("common.noneInstalled");
                        enabled: root.models.length > 0;
                        changed(index) => { root.model-changed(index); }
                    }
                }
                if root.data.provider == 0: HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.t("captions.geminiProofread");
                        color: Theme.fg;
                        font-size: Theme.fs;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: root.data.gemini-proofread;
                            toggled(on) => { root.gemini-proofread-toggled(on); }
                        }
                    }
                }
                if root.data.provider == 0 && root.data.gemini-proofread: DialogRow {
                    label: "Tên riêng / thuật ngữ";
                    Field { value: root.data.glossary; placeholder: "Tên nhân vật, địa danh, từ chuyên môn…"; max-length: 4000; edited(text) => { root.glossary-edited(text); } }
                }
                if root.data.provider == 0 && root.data.gemini-proofread: Text {
                    text: I18n.t("captions.geminiProofreadNotice");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                if !root.data.ready && root.data.provider == 0: Text {
                    text: I18n.t("captions.downloadTranscriberModelFirst");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }

            if !root.data.running: DialogSection {
                title: I18n.t("captions.captions");

                DialogRow {
                    label: I18n.t("captions.placement");
                    SegmentedControl {
                        options: [I18n.t("common.bottom"), I18n.t("captions.centre"), I18n.t("common.top")];
                        current: root.data.placement;
                        changed(index) => { root.placement-changed(index); }
                    }
                }

                DialogRow {
                    label: I18n.t("common.size");
                    SegmentedControl {
                        options: [I18n.t("common.small"), I18n.t("common.medium"), I18n.t("common.large")];
                        current: root.data.size;
                        changed(index) => { root.size-changed(index); }
                    }
                }

                DialogRow {
                    label: root.data.gemini-two-speakers ? I18n.t("captions.speaker1Color") : I18n.t("captions.textColor");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c[i] in [
                            { name: "Trắng", val: #ffffff },
                            { name: "Vàng", val: #ffe600 },
                            { name: "Xanh lơ", val: #00e5ff },
                            { name: "Xanh lá", val: #69f0ae }
                        ]: Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: c.val;
                            border-width: root.data.text-color == c.val ? 2px : 1px;
                            border-color: root.data.text-color == c.val ? Theme.accent : Theme.line;
                            TouchArea {
                                clicked => { root.text-color-changed(c.val); }
                                mouse-cursor: pointer;
                            }
                        }
                        ColourField {
                            label: "";
                            value: root.data.text-color;
                            changed(c) => { root.text-color-changed(c); }
                        }
                    }
                }

                if root.data.gemini-two-speakers: DialogRow {
                    label: I18n.t("captions.speaker2Color");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c[i] in [
                            { name: "Vàng", val: #ffe600 },
                            { name: "Xanh lơ", val: #00e5ff },
                            { name: "Hồng", val: #ff80ab },
                            { name: "Xanh lá", val: #69f0ae }
                        ]: Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: c.val;
                            border-width: root.data.speaker2-color == c.val ? 2px : 1px;
                            border-color: root.data.speaker2-color == c.val ? Theme.accent : Theme.line;
                            TouchArea {
                                clicked => { root.speaker2-color-changed(c.val); }
                                mouse-cursor: pointer;
                            }
                        }
                        ColourField {
                            label: "";
                            value: root.data.speaker2-color;
                            changed(c) => { root.speaker2-color-changed(c); }
                        }
                    }
                }

                DialogRow {
                    label: I18n.t("captions.stroke");
                    SegmentedControl {
                        options: [
                            I18n.t("captions.strokeNone"),
                            I18n.t("captions.strokeThin"),
                            I18n.t("captions.strokeMedium"),
                            I18n.t("captions.strokeThick")
                        ];
                        current: root.data.stroke-choice;
                        changed(index) => { root.stroke-choice-changed(index); }
                    }
                }

                if root.data.stroke-choice > 0: DialogRow {
                    label: I18n.t("captions.strokeColor");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c[i] in [
                            { name: "Đen", val: #000000 },
                            { name: "Trắng", val: #ffffff },
                            { name: "Đỏ", val: #d50000 },
                            { name: "Xanh đậm", val: #0d47a1 }
                        ]: Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: c.val;
                            border-width: root.data.stroke-color == c.val ? 2px : 1px;
                            border-color: root.data.stroke-color == c.val ? Theme.accent : Theme.line;
                            TouchArea {
                                clicked => { root.stroke-color-changed(c.val); }
                                mouse-cursor: pointer;
                            }
                        }
                        ColourField {
                            label: "";
                            value: root.data.stroke-color;
                            changed(c) => { root.stroke-color-changed(c); }
                        }
                    }
                }

                Rectangle {
                    height: root.data.gemini-two-speakers ? 68px : 44px;
                    border-radius: Theme.r;
                    background: #141416;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.data.gemini-two-speakers ? I18n.t("captions.previewSpeaker1") : "Phụ đề mẫu · Concat Video Editor";
                            color: root.data.text-color;
                            font-size: root.data.size == 0 ? 13px : (root.data.size == 1 ? 15px : 17px);
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        if root.data.gemini-two-speakers: Text {
                            text: I18n.t("captions.previewSpeaker2");
                            color: root.data.speaker2-color;
                            font-size: root.data.size == 0 ? 13px : (root.data.size == 1 ? 15px : 17px);
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Text {
                    text: root.from-voice
                        ? I18n.t("captions.oneTitlePerPhrase")
                        : I18n.t("captions.oneTitlePerSentence");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                if root.data.message != "": Rectangle {
                    border-radius: Theme.r;
                    background: Theme.danger-soft;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: start;
                            Icon { glyph: Glyph.close; size: 13px; tint: Theme.danger; }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.data.message;
                            color: Theme.danger;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }

                        VerticalLayout {
                            alignment: start;
                            CopyChip { text: root.data.message; }
                        }
                    }
                }

                if root.data.running: VerticalLayout {
                    spacing: 8px;

                    row := HorizontalLayout {
                        spacing: 8px;
                        // The time left, once the work has been timed: counted down
                        // from the last report, and gone in the last second.
                        property <int> left: Math.ceil(Math.max(0, root.data.left - bar.since / 1s));

                        Text {
                            horizontal-stretch: 1;
                            text: root.data.stage;
                            color: Theme.fg;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                        }

                        if root.data.left >= 0 && row.left > 0: Text {
                            text: I18n.t2("common.aboutLeft", "\{Math.floor(row.left / 60)}",
                                (Math.mod(row.left, 60) < 10 ? "0" : "") + "\{Math.mod(row.left, 60)}");
                            color: Theme.fg-dim;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "\{Math.floor(bar.shown * 100)}%";
                            color: Theme.fg-muted;
                            font-family: Theme.font-technical;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                        }
                    }

                    bar := Progress {
                        value: root.data.progress;
                        ceiling: root.data.ceiling;
                        step: root.data.step * 1s;
                        live: true;
                    }
                }

                if root.data.running: HorizontalLayout {
                    alignment: start;
                    Button {
                        label: I18n.t("common.cancel");
                        glyph: Glyph.close;
                        ghost: true;
                        clicked => { root.cancel(); }
                    }
                }

                if !root.data.running: Button {
                    block: true;
                    primary: true;
                    large: true;
                    glyph: Glyph.text-mark;
                    label: root.from-voice ? I18n.t("captions.generateCaptions") : I18n.t("captions.addCaptions");
                    enabled: root.from-voice ? root.data.ready && root.data.source >= 0 : root.draft != "";
                    clicked => { root.begin(); }
                }

                if !root.data.running: Button {
                    label: I18n.t("captions.wrapExisting");
                    block: true;
                    ghost: true;
                    clicked => { root.wrap-existing(); }
                }

                // Captions as a SubRip file: one read in as titles with the
                // look above, timed as the file says; or a lane of titles
                // written out: the selected title's lane, or with none
                // selected the lane with the most titles, the captions'.
                if !root.data.running: HorizontalLayout {
                    spacing: 8px;

                    Button {
                        horizontal-stretch: 1;
                        block: true;
                        ghost: true;
                        glyph: Glyph.import;
                        label: I18n.t("captions.importSrt");
                        clicked => { root.import-srt(); }
                    }

                    Button {
                        horizontal-stretch: 1;
                        block: true;
                        ghost: true;
                        glyph: Glyph.export;
                        label: I18n.t("captions.exportSrt");
                        clicked => { root.export-srt(); }
                    }
                }
            }
            }
        }
    }
}
