                        GuideStepCard {
                            badge: "Phụ đề AI";
                            title: "1. Tạo Phụ đề AI (.SRT) & Chuẩn hóa Gemini";
                            body: "Hỗ trợ PhoWhisper offline tiếng Việt chính xác cao hoặc chế độ Gemini Cloud với tính năng: Tự hiệu đính chính tả tiếng Việt, Tách dòng thông minh không bị tràn khung, Nhận diện 2 người nói (tách 2 màu chữ) và Từ điển thuật ngữ riêng.";
                        }
                        GuideStepCard {
                            badge: "Dịch & Đọc";
                            title: "2. Dịch Phụ đề & Lồng tiếng bám Timestamp";
                            body: "Dịch tệp .SRT hoặc trực tiếp từ audio video giữa nhiều ngôn ngữ (Anh, Việt, Trung, Nhật, Hàn...), chỉnh từng dòng song ngữ và tạo thuyết minh co tốc độ khớp từng mốc thời gian.";
                        }
                        GuideStepCard {
                            badge: "TTS & Clone";
                            title: "3. Phòng Thu Âm Thanh, Nhân bản Giọng & Thẻ Cảm xúc";
                            body: "Đọc văn bản với giọng Piper Tiếng Việt miễn phí hoặc Gemini Pro TTS. Hỗ trợ nhân bản giọng nói từ tệp mẫu WAV, và chèn thẻ diễn xuất ngay trong lời thoại như [cười], [thở dài], [nói nhanh], [thì thầm].";
                        }
                        GuideStepCard {
                            badge: "Voice FX";
                            title: "4. Voice Changer AI (ElevenLabs) & 10 Preset DSP Offline";
                            body: "Biến đổi chất giọng sang nhân vật mới qua ElevenLabs Speech-to-Speech hoặc áp dụng tức thì 10 bộ lọc DSP chạy ngoại tuyến: Giọng trầm điện ảnh, Nữ thanh thoát, Em bé, Robot, Phát thanh FM, Vang nhà thờ...";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button { label: "Mở Tạo Phụ Đề AI"; glyph: Glyph.subtitles; clicked => { root.open-link("tool-captions"); } }
                                Button { label: "Mở Dịch & Lồng Tiếng"; glyph: Glyph.translate; clicked => { root.open-link("tool-translation"); } }
                                Button { label: "Mở Voice Changer"; glyph: Glyph.voice-changer; clicked => { root.open-link("tool-voice-changer"); } }
                            }
                        }
                        GuideScreenshot {
                            shot: @image-url("../assets/guide/05.jpg");
                            ratio: 853 / 1160;
                            caption: "Hình 7: Studio Tạo Phụ Đề AI, Dịch Song Ngữ, Phòng Thu Giọng Nói và Voice Changer.";
                        }
                    }

                    // ══ CHAPTER 7: GOOGLE FLOW STUDIO 5 BƯỚC ═════════════════
                    if root.section == 7: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Google Flow Studio — Sản xuất Phim AI 5 Bước";
                            color: Theme.fg;
                            font-size: 18px;
                            font-weight: Theme.weight-display;
                            wrap: word-wrap;
                        }
                        GuideCallout {
                            title: "Yêu cầu chuẩn bị trước khi dùng Flow Studio";
                            body: "Đảm bảo đã nhập Gemini API Key (để viết kịch bản) trong Cài đặt Chung và đã Kết nối Chrome CDP thành công tại Cài đặt › Google Flow (Xem Chuyên mục 02 & 03).";
                        }
                        GuideStepCard {
                            badge: "Bước 1";
                            title: "Ý tưởng & Chia Cảnh Kịch bản (Script & Prompts)";
                            body: "Nhập chủ đề, chọn thể loại (Phim ngắn, Quảng cáo, Tài liệu, Hướng dẫn, Truyện thiếu nhi) và phong cách hình ảnh. Gemini tự tách cảnh quay, lời thoại và prompt điện ảnh chuyên nghiệp cho Veo 3.1.";
                        }
                        GuideStepCard {
                            badge: "Bước 2";
                            title: "Tạo & Khóa Tạo hình Nhân vật (Character Consistency)";
                            body: "Sinh bảng tham chiếu khuôn mặt/trang phục nhân vật hoặc chọn lại từ Thư viện Nhân vật của bạn để mọi cảnh quay về sau giữ đúng một gương mặt đồng nhất.";
                        }
                        GuideStepCard {
                            badge: "Bước 3";
                            title: "Tạo Ảnh Mở Đầu Cảnh (Opening Frame — Nano Banana Pro)";
                            body: "Flow render ảnh đầu cảnh sắc nét từ prompt cảnh + ảnh nhân vật đã gắn tag, giúp bạn duyệt trước bố cục và ánh sáng trước khi tốn thời gian render video.";
                        }
                        GuideStepCard {
                            badge: "Bước 4 & 5";
                            title: "Tạo Video Veo 3.1 (Fast/Quality/Extend) & Đưa xuống Timeline";
                            body: "Chạy render tự động qua 1–4 luồng Chrome CDP song song, hỗ trợ nối dài video (Extend Scene), rồi bấm 'Đưa toàn bộ lên Timeline' để ghép nhạc, lời thoại và xuất bản.";
                        }
                        GuideScreenshot {
                            shot: @image-url("../assets/guide/04.jpg");
                            ratio: 1066 / 1160;
                            caption: "Hình 8: Giao diện Google Flow Studio 5 bước bên trong bảng Inspector của dự án.";
                        }
                    }

                    // ══ CHAPTER 8: TẢI LINK & XUẤT VIDEO ═════════════════════
                    if root.section == 8: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Tải Link YouTube/TikTok/Drive & Xuất Video 4K / CapCut";
                            color: Theme.fg;
                            font-size: 18px;
                            font-weight: Theme.weight-display;
                            wrap: word-wrap;
                        }
                        GuideStepCard {
                            badge: "Tải Link";
                            title: "Tải Video & Tách Nhạc Nhanh (yt-dlp & Google Drive)";
                            body: "Dán một hoặc nhiều URL từ YouTube, TikTok, Facebook, Google Drive vào hộp thoại Tải Link. Chọn tải toàn bộ Video chất lượng cao, chỉ Tách nhạc MP3/WAV hoặc tải kèm phụ đề rồi chèn thẳng vào Kho Media.";
                            HorizontalLayout {
                                spacing: 8px;
