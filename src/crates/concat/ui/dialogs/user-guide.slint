                                Button { label: "Mở Hộp thoại Tải Link"; glyph: Glyph.cloud-download; clicked => { root.open-link("tool-links"); } }
                            }
                        }
                        GuideStepCard {
                            badge: "Xuất File";
                            title: "Xuất Video 4K 10-bit/HDR & Xuất sang CapCut PC";
                            body: "Mở Hộp thoại Xuất (Ctrl+E): chọn FPS (24–60), Codec (H.264 tương thích rộng, HEVC/H.265 dung lượng gọn, AV1 nén tối đa, ProRes dựng hậu kỳ), bật 10-bit và HDR nếu cần dải màu rộng, chỉnh Bitrate hoặc bấm 'Xuất sang CapCut' để bàn giao trọn bộ track + phụ đề qua CapCut PC.";
                        }
                        GuideScreenshot {
                            shot: @image-url("../assets/guide/07.jpg");
