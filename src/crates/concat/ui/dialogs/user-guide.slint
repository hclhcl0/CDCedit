                    // ══ CHAPTER 9: PHÍM TẮT & XỬ LÝ SỰ CỐ ════════════════════
                    if root.section == 9: VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Phím tắt Chuẩn & Xử lý Sự cố Thường gặp";
                            color: Theme.fg;
                            font-size: 18px;
                            font-weight: Theme.weight-display;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button { label: "Đổi Phím tắt trong Cài đặt"; glyph: Glyph.keyboard; primary: true; clicked => { root.open-settings-page(7); } }
                            Button { label: "Báo cáo sự cố (GitHub)"; glyph: Glyph.bug; clicked => { root.open-link("report"); } }
                        }

                        GuideShortcutRow { keys: "Space"; action: "Phát / Tạm dừng video xem trước"; note: "Bấm giữ K rồi bấm J/L để tua chậm lùi hoặc tiến"; }
                        GuideShortcutRow { keys: "J / K / L"; action: "Tua lùi / Dừng / Tua nhanh 2x–4x"; }
                        GuideShortcutRow { keys: "I / O"; action: "Đặt điểm vào (In) / Điểm ra (Out) cho vùng chọn"; }
                        GuideShortcutRow { keys: "V / C"; action: "Chuyển công cụ Chọn (V) hoặc Dao Cắt clip (C)"; }
                        GuideShortcutRow { keys: "Q / W"; action: "Cắt & Xóa nhanh đoạn bên trái (Q) hoặc bên phải (W) kim thời gian"; }
                        GuideShortcutRow { keys: "S"; action: "Bật / Tắt Nam châm hút mép clip (Snapping)"; }
                        GuideShortcutRow { keys: "Ctrl + Z"; action: "Hoàn tác (Undo) · Ctrl + Shift + Z để Làm lại (Redo)"; }
                        GuideShortcutRow { keys: "Ctrl + E"; action: "Mở Hộp thoại Xuất Video & Xuất sang CapCut"; }

                        GuideCallout {
                            warning: true;
                            title: "Khắc phục nhanh các lỗi thường gặp";
                            body: "• Lỗi 429 Quota Gemini: Dán 2–5 API Key ngăn cách bằng dấu ';' để app tự xoay vòng.\n• Flow báo chưa đăng nhập / 403: Kiểm tra lại Chrome CDP đang chạy cùng cổng 9337 và đăng nhập labs.google/fx.\n• Không tìm thấy file sau khi đổi ổ đĩa: Mở lại dự án và chọn 'Relink Media' trỏ vào thư mục mới.";
                        }
                    }
                }
            }
        }

        // ── Bottom Footer Navigation Bar ──
        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        Rectangle {
            height: 50px;
            background: Theme.panel;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                Button {
                    label: "Mở bản PDF (13 trang)";
                    glyph: Glyph.book;
                    clicked => { root.open-link("guide-pdf"); }
                }

                Button {
                    label: "Cài đặt API";
                    glyph: Glyph.settings;
                    ghost: true;
                    clicked => { root.open-settings-page(0); }
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Mục \{root.section + 1} / 10";
                        color: Theme.fg-dim;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-sm;
                    }
                }

                Button {
                    label: "Trước";
                    glyph: Glyph.chevron-left;
                    enabled: root.section > 0;
                    clicked => { root.section-changed(Math.max(0, root.section - 1)); }
                }

                Button {
                    label: "Tiếp";
                    glyph: Glyph.chevron-right;
                    primary: root.section < 9;
                    enabled: root.section < 9;
                    clicked => { root.section-changed(Math.min(9, root.section + 1)); }
                }
            }
        }
    }
}
