                    Field {value:root.data.movement;placeholder:"Chuyển động máy: tĩnh, pan, dolly, push-in…";enabled:!root.data.busy;edited(text)=>{root.action(56,0,text);}}
                    Select {options:["Gợi ý ánh sáng…","Ánh sáng tự nhiên dịu (Soft natural light)","Nắng chiều ấm (Golden hour)","Ánh sáng xanh chạng vạng (Blue hour)","Trời nhiều mây (Overcast diffuse)","Ánh sáng cửa sổ (Window light)","Tương phản điện ảnh (Cinematic chiaroscuro)","Neon ban đêm (Night neon)","Ngược sáng viền (Rim backlight)"];current:0;enabled:!root.data.busy;changed(index)=>{if index>0 {root.action(62,0,self.options[index]);self.current=0;}}}
                    Field {value:root.data.lighting;placeholder:"Ánh sáng · có thể nhập tùy ý";enabled:!root.data.busy;edited(text)=>{root.action(62,0,text);}}
                    Select {options:["Gợi ý âm thanh / nhạc…","Âm thanh môi trường tự nhiên, không nhạc","Chỉ lời thoại, không nhạc nền","Không lời thoại, không nhạc","Tiếng chim và gió nhẹ","Âm thanh xưởng thủ công chân thực","Nhạc nền piano nhẹ","Nhạc nền căng thẳng điện ảnh"];current:0;enabled:!root.data.busy;changed(index)=>{if index>0 {root.action(57,0,self.options[index]);self.current=0;}}}
