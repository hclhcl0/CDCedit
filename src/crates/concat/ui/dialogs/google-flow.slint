// SPDX-License-Identifier: AGPL-3.0-or-later
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Modal, DialogSection, DialogRow, Button, Field } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Switch } from "../inspector/controls.slint";
import { PaneScroll } from "../workspace/pane.slint";

export struct FlowFile {name:string,path:string,preview:image,status:string}
export struct FlowSceneRow {name:string,status:string,selected:bool}
export struct FlowCastRow {name:string,selected:bool,action:string}
export struct FlowDialogueRow {speaker:int,text:string}
export struct FlowAsset {path:string,preview:image}
export struct FlowReferenceImage {label:string,path:string,preview:image,kind:string,approved:bool,selected:bool}
export struct FlowGallery {items:[FlowReferenceImage]}
export struct FlowRemoteCharacter {name:string,detail:string,imported:bool}
component ScriptEditor inherits Rectangle {
    in-out property <string> value;
    in property <bool> enabled:true;
    callback edited(string);
    height:100px;background:Theme.field;border-radius:Theme.r;clip:true;
    TextInput {x:10px;y:10px;width:parent.width - 20px;height:parent.height - 20px;text<=>root.value;color:Theme.fg;font-size:Theme.fs;wrap:word-wrap;enabled:root.enabled;edited=>{root.edited(self.text);}}
}
export struct FlowData {open:bool,busy:bool,credit:bool,url:string,prompt:string,reference:string,model:int,duration:int,ratio:int,message:string,can-import:bool,desktop:bool,files:[FlowFile],screenplay:string,continuity:string,style:string,scene:int,scenes:[string],scene-text:string,characters:[string],brief:string,ai-ready:bool,camera:string,shot:string,movement:string,sound:string,dialogue:string,lighting:string,scene-status:string,queued:bool,queue-count:int,scene-rows:[FlowSceneRow],cast-rows:[FlowCastRow],backgrounds:[string],background:int,background-edit:int,background-text:string,character-images:[FlowAsset],background-image:FlowAsset,image-model:string,image-provider:int,image-ready-message:string,character-galleries:[FlowGallery],scene-images:[FlowReferenceImage],scene-image:FlowAsset,scene-image-status:string,flow-image-model:int,flow-image-ratio:int,transfer-path:string,validation:string,writing-format:int,writing-structure:int,writing-scene-count:int,writing-audience:string,writing-goal:string,logline:string,remote-characters:[FlowRemoteCharacter],character-names:[string],character-roles:[string],dialogue-rows:[FlowDialogueRow],flow-link-target:int,account-names:[string],scene-account-names:[string],source-account:int,scene-account:int,scene-project-url:string,account-summary:string,video-provider:int,visual-mode:int,end-image:FlowAsset,scene-flow-auto:bool,auto-delogo:bool,auto-upscale:bool,auto-import-timeline:bool}
export component GoogleFlowDialog inherits Rectangle {
    in property <FlowData> data;
    callback action(int,int,string);
    private property <string> draft;
    private property <bool> typing;
    init=>{root.draft=root.data.prompt;}
    changed data=>{if(!root.typing || !root.data.open){root.draft=root.data.prompt;}}
    in-out property <int> tab:0;
    private property <int> queue-filter:0;
    private property <bool> show-prompt:true;
    private property <[string]> step-names:["Kịch bản","Nhân vật","Cảnh","Tạo video","Kết quả"];
    changed tab=>{root.typing=false;root.draft=root.data.prompt;}
    background:Theme.panel;clip:true;
    HorizontalLayout {
        spacing: 8px;
        if root.width >= 900px: Rectangle {
            width: 220px; background: Theme.well;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                Text { text: "Dự án Flow"; color: Theme.fg; font-size: Theme.fs-lg; }
                Button { label: "Kịch bản tổng thể"; ghost: root.tab != 0;
                    clicked => { root.tab = 0; } }
                Text { text: "CẢNH · " + root.data.scenes.length;
                    color: Theme.fg-muted; font-size: Theme.fs-xs; }
                PaneScroll {
                    vertical-stretch: 1;
                    VerticalLayout { spacing: 6px;
                        for name[index] in root.data.scenes: Button {
                            label: name; primary: root.data.scene == index;
                            enabled: !root.data.busy;
                            clicked => { root.action(23,index,""); if root.tab < 2 { root.tab = 2; } }
                        }
                        if root.data.scenes.length == 0: Text {
                            text: "Viết kịch bản hoặc thêm cảnh để bắt đầu.";
                            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
                        }
                    }
                }
                Button { label: "+ Thêm cảnh"; ghost: true; enabled: !root.data.busy;
                    clicked => { root.action(25,0,""); root.tab = 2; } }
                Button { label: "Nhân vật · " + root.data.characters.length;
                    ghost: root.tab != 1; clicked => { root.tab = 1; } }
                Button { label: "Kết quả"; ghost: root.tab != 4;
                    clicked => { root.tab = 4; } }
            }
        }
    VerticalLayout {
        horizontal-stretch: 1;
        padding:8px;spacing:8px;
        HorizontalLayout {
            Text {text:"Flow Studio";color:Theme.fg;font-size:Theme.fs-lg;horizontal-stretch:1;vertical-alignment:center;}
            Text {text:"Bước "+(root.tab+1)+" / 5";color:Theme.fg-muted;font-size:Theme.fs-sm;vertical-alignment:center;}
        }
        HorizontalLayout {spacing:4px;
            for name[index] in root.step-names: Button {
                label:""+(index+1)+" "+name;
                primary:root.tab==index;
                clicked=>{root.tab=index;}
            }
        }
        Text {
            text:root.tab==0 ? (root.data.scenes.length>0 ? "Đã có "+root.data.scenes.length+" cảnh · tiếp tục hoàn thiện nhân vật" : "Bắt đầu từ ý tưởng hoặc dán kịch bản có sẵn")
                : root.tab==1 ? "Hồ sơ dùng chung · "+root.data.characters.length+" nhân vật"
                : root.tab==2 ? "Chỉnh từng cảnh · nhân vật, lời thoại và prompt"
                : root.tab==3 ? (root.data.queued ? "Hàng đợi đang chạy · còn "+root.data.queue-count+" cảnh" : "Kiểm tra dự án, model và chuẩn bị trước khi tạo")
                : "Chọn cảnh để xem và nhập video đã hoàn tất";
            color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;
        }
        if root.tab>=2 && root.width < 900px: VerticalLayout {
            spacing:4px;
            Text {text:"Cảnh đang chọn";color:Theme.fg-muted;font-size:Theme.fs-xs;}
            Select {options:root.data.scenes;current:root.data.scene;enabled:!root.data.busy;changed(index)=>{root.action(23,index,"");}}
        }
        if root.data.message!="": Text {text:root.data.message;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
        PaneScroll {
            reset-token:root.tab;
            vertical-stretch:1;
            VerticalLayout {
                if root.tab==0: HorizontalLayout {
                    spacing: 8px;
                    padding-bottom: 4px;
                    Button {
                        label: "📄 Tạo kịch bản mới";
                        primary: root.data.scenes.length == 0;
                        ghost: root.data.scenes.length > 0;
                        enabled: !root.data.busy;
                        clicked => { root.action(47, 0, ""); }
                    }
                    if root.data.scenes.length > 0: Text {
                        text: "Hiện có " + root.data.scenes.length + " cảnh trong dự án";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }
                if root.tab==0: DialogSection {
                    first:true;title:"Gemini · Trợ lý nội dung";
                    Text {text:root.data.ai-ready ? "Dùng Gemini API key trong Cài đặt. Gửi ý tưởng và nội dung dự án khi bấm nút AI; có thể phát sinh phí Gemini." : "Chưa có Gemini API key. Thêm key trong Cài đặt để dùng AI.";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
                    ScriptEditor {height:70px;value:root.data.brief;enabled:!root.data.busy;edited(text)=>{root.action(40,0,text);}}
                    Text {text:"Ý tưởng / yêu cầu: chủ đề, tên nhân vật, số cảnh, địa điểm, phong cách…";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                }
                if root.tab==0: DialogSection {
                    title:"Kịch bản tổng thể";
                    Text {text:"Áp dụng skill: cấu trúc truyện → nhân vật → cảnh → lời thoại. Mỗi cảnh theo thời lượng đang chọn ở bước Tạo video.";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
                    DialogRow {label:"Dạng video";Select {options:["Phim ngắn","Quảng cáo sản phẩm","Phim tài liệu","Hướng dẫn","Truyện thiếu nhi"];current:root.data.writing-format;enabled:!root.data.busy;changed(index)=>{root.action(90,index,"");}}}
                    DialogRow {label:"Cấu trúc";Select {options:["Mở · phát triển · kết","Mục tiêu · trở ngại · kết quả","Vấn đề · giải pháp","Tự do theo ý tưởng"];current:root.data.writing-structure;enabled:!root.data.busy;changed(index)=>{root.action(91,index,"");}}}
                    DialogRow {label:"Số cảnh AI";Select {options:["1 cảnh","2 cảnh","3 cảnh","4 cảnh","5 cảnh","6 cảnh","7 cảnh","8 cảnh","9 cảnh","10 cảnh","11 cảnh","12 cảnh"];current:root.data.writing-scene-count - 1;enabled:!root.data.busy;changed(index)=>{root.action(92,index+1,"");}}}
                    Field {value:root.data.writing-audience;placeholder:"Đối tượng xem: trẻ 6–10 tuổi, khách du lịch…";enabled:!root.data.busy;edited(text)=>{root.action(93,0,text);}}
                    Field {value:root.data.writing-goal;placeholder:"Mục tiêu / thông điệp người xem cần nhớ";enabled:!root.data.busy;edited(text)=>{root.action(94,0,text);}}
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            label: root.data.busy ? "Đang xử lý…" : (root.data.scenes.length > 0 ? "✨ AI viết lại kịch bản mới" : "✨ AI viết kịch bản mới");
                            primary: true;
                            enabled: root.data.ai-ready && !root.data.busy;
                            clicked => { root.action(48, 0, ""); }
                        }
                        if root.data.scenes.length > 0: Button {
                            label: "➕ AI viết thêm cảnh";
                            ghost: true;
                            enabled: root.data.ai-ready && !root.data.busy;
                            clicked => { root.action(41, 0, ""); }
                        }
                    }
                    if root.data.logline!="": Text {text:"Ý chính: "+root.data.logline;color:Theme.fg;font-size:Theme.fs-sm;wrap:word-wrap;}
                    HorizontalLayout {
                        Text {
                            text: "Dán kịch bản, mỗi cảnh cách nhau một dòng trống. Ghi hành động và lời thoại trong từng cảnh.";
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            label: "📄 Xóa trắng kịch bản";
                            ghost: true;
                            enabled: !root.data.busy && root.data.screenplay != "";
                            clicked => { root.action(47, 0, ""); }
                        }
                    }
                    ScriptEditor {height:root.width >= 900px ? 240px : 100px;value:root.data.screenplay;enabled:!root.data.busy;edited(text)=>{root.action(20,0,text);}}
                    Button {label:"AI trích xuất nhân vật & phân vai theo cảnh";enabled:root.data.ai-ready && !root.data.busy && root.data.scenes.length>0;clicked=>{root.action(46,0,"");}}
                    Text {text:"Kịch bản AI tự đồng bộ hồ sơ, người xuất hiện và người nói. Với kịch bản viết tay, dùng Trích xuất để liên kết vào tab Nhân vật. Đồng bộ có sao lưu bản cũ; không tạo ảnh hay video.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                    HorizontalLayout {spacing:4px;
                        Button {label:"Xuất bộ cảnh JSON";enabled:!root.data.busy;clicked=>{root.action(71,0,"");}}
                        Button {label:"Nhập JSON";ghost:true;enabled:!root.data.busy && root.data.transfer-path!="";clicked=>{root.action(72,0,"");}}
                    }
                    Field {value:root.data.transfer-path;placeholder:"Đường dẫn file JSON bộ cảnh để nhập";enabled:!root.data.busy;edited(text)=>{root.action(70,0,text);}}
                    Text {text:"Nhập bộ cảnh sẽ thay nội dung hiện tại và lưu bản sao flow-before-import.json. File JSON lưu đường dẫn ảnh, không đóng gói ảnh.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                }
                if root.tab==1: DialogSection {
                    first:true;title:"Hồ sơ nhân vật dùng chung";
                    Text {text:"Lấy nhân vật đã có trên Flow";color:Theme.fg;font-size:Theme.fs;}
                    Text {text:"Tài khoản nguồn";color:Theme.fg-muted;font-size:Theme.fs-sm;}
                    Select {options:root.data.account-names;current:root.data.source-account;enabled:!root.data.busy;changed(index)=>{root.action(121,index,"");}}
                    Button {label:"Quản lý tài khoản trong Cài đặt";ghost:true;clicked=>{root.action(120,0,"");}}
                    HorizontalLayout {
                        spacing: 6px;
                        Field {value:root.data.url;placeholder:"https://flow.google.com/project/…";horizontal-stretch:1;enabled:!root.data.busy;edited(text)=>{root.action(2,0,text);}}
                        Button {label:"➕ Tạo dự án Flow mới";enabled:root.data.desktop && !root.data.busy;clicked=>{root.action(161,0,"");}}
                    }
                    Button {label:"Đọc thư viện nhân vật Flow";enabled:root.data.desktop && !root.data.busy;clicked=>{root.action(100,0,"");}}
                    Text {text:"Nhập mới hoặc gắn nhân vật Flow vào hồ sơ đã có trong kịch bản";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
                    Select {options:root.data.character-names;current:root.data.flow-link-target;enabled:!root.data.busy;changed(index)=>{root.action(112,index,"");}}
                    Text {text:"Đọc hồ sơ và tải ảnh có sẵn, không tạo lại và không dùng credit. Cập nhật hồ sơ đã nhập sẽ có bản sao dự phòng. Giọng nói được lưu dưới dạng mã tham chiếu, chưa tải tệp âm thanh.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                    for remote[index] in root.data.remote-characters: VerticalLayout {
                        HorizontalLayout {spacing:6px;
                            Text {text:remote.name;color:Theme.fg;font-size:Theme.fs;horizontal-stretch:1;vertical-alignment:center;wrap:word-wrap;}
                            Button {label:root.data.flow-link-target>0 ? "Gắn vào hồ sơ đã chọn" : (remote.imported ? "Cập nhật từ Flow" : "Nhập nhân vật");enabled:!root.data.busy;clicked=>{root.action(101,index,"");}}
                        }
                        Text {text:remote.detail;color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                    }
                    HorizontalLayout {spacing:4px;
                        Button {label:"AI viết hồ sơ nhân vật";primary:true;enabled:root.data.ai-ready && !root.data.busy;clicked=>{root.action(42,0,"");}}
                        Button {label:"✨ AI Khóa Agent Instructions vào Flow";primary:true;enabled:root.data.desktop && !root.data.busy && root.data.ai-ready;clicked=>{root.action(160,0,"");}}
                    }
                    Text {text:"Dùng tên nhân vật trong cảnh. Mỗi hồ sơ giữ tên, ngoại hình, trang phục và giọng nói nhất quán.";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
                    Button {label:"+ Thêm nhân vật";enabled:!root.data.busy;clicked=>{root.action(28,0,"");}}
                    Text {text:"Tạo ảnh nhân vật & bối cảnh";color:Theme.fg;font-size:Theme.fs;}
                    Select {options:["Google Flow · tài khoản đã đăng nhập","Gemini API · key trong Cài đặt"];current:root.data.image-provider;enabled:!root.data.busy;changed(index)=>{root.action(124,index,"");}}
                    if root.data.image-provider == 0: VerticalLayout {
                        spacing:6px;
                        Button {label:"Mở / kết nối lại Chrome Flow";ghost:true;enabled:root.data.desktop && !root.data.busy;clicked=>{root.action(10,0,"");}}
                        DialogRow {label:"Model ảnh";Select {options:["Nano Banana Pro","Nano Banana 2","Nano Banana 2 Lite"];current:root.data.flow-image-model;enabled:!root.data.busy;changed(index)=>{root.action(125,index,"");}}}
                        DialogRow {label:"Tỷ lệ ảnh";Select {options:["1:1","9:16","16:9","3:4","4:3"];current:root.data.flow-image-ratio;enabled:!root.data.busy;changed(index)=>{root.action(126,index,"");}}}
                        Text {text:"Dùng tài khoản nguồn đã chọn ở trên và URL mặc định của tài khoản (nếu có), nếu không dùng URL dự án ở trên. Không cần Gemini API key; tạo ảnh có thể dùng credit Flow. Ảnh tạo mới chưa phải hồ sơ nhân vật có giọng gắn sẵn trên Flow.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                        Text {text:root.data.image-ready-message;color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                    }
                    if root.data.image-provider == 1: VerticalLayout {
                        spacing:6px;
                        Field {value:root.data.image-model;placeholder:"Gemini image model ID";enabled:!root.data.busy;edited(text)=>{root.action(79,0,text);}}
                        Text {text:"Tạo ảnh dùng Gemini API key và có thể phát sinh phí riêng. Quota API độc lập với tài khoản Flow.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                    }
                    for character[index] in root.data.characters: VerticalLayout {
                        Text {text:root.data.character-names[index+1];color:Theme.fg;font-size:Theme.fs-sm;wrap:word-wrap;}
                        Field {value:root.data.character-roles[index];placeholder:"Vai nhân vật: người cha, học sinh… để phân biệt người trùng tên";enabled:!root.data.busy;edited(text)=>{root.action(113,index,text);}}
                        ScriptEditor {value:character;enabled:!root.data.busy;edited(text)=>{root.action(29,index,text);}}
                        if root.data.character-images[index].path!="": Image {height:130px;source:root.data.character-images[index].preview;image-fit:contain;}
                        HorizontalLayout {spacing:4px;
                            Button {label:"Chọn ảnh từ máy";enabled:root.data.desktop && !root.data.busy;clicked=>{root.action(95,index,"");}}
                            Button {label:root.data.image-provider == 0 ? "Tạo ảnh bằng Flow" : "Tạo ảnh Gemini";enabled:!root.data.busy && (root.data.image-provider == 0 ? root.data.desktop && root.data.source-account>=0 : root.data.ai-ready);clicked=>{root.action(80,index,"");}}
                        }
                        if root.data.image-provider == 0: HorizontalLayout {spacing:4px;
                            Button {label:"Tạo bộ ảnh nhân vật (3 góc)";enabled:root.data.desktop && !root.data.busy && root.data.character-images[index].path!="";clicked=>{root.action(127,index,"");}}
                            Button {label:"Kiểm tra Flow · chưa gửi";ghost:true;enabled:root.data.desktop && !root.data.busy;clicked=>{root.action(134,index,"");}}
                        }
                        Text {text:"Ảnh chuẩn được giữ khi tạo lại. Bộ 3 góc gồm chính diện, sau lưng và cận mặt ¾ trong một ảnh 16:9. Duyệt bộ ảnh trước khi dùng tạo ảnh cảnh.";color:Theme.fg-muted;font-size:Theme.fs-xs;wrap:word-wrap;}
                        for reference[image-index] in root.data.character-galleries[index].items: HorizontalLayout {
                            spacing:8px;
                            Image {width:76px;height:76px;source:reference.preview;image-fit:contain;}
                            VerticalLayout {spacing:4px;
                                Text {text:reference.label+(reference.selected ? " · Ảnh chuẩn" : "")+(reference.approved ? " · Đã duyệt" : "");color:Theme.fg;font-size:Theme.fs-sm;wrap:word-wrap;}
                                HorizontalLayout {spacing:4px;
                                    Button {label:"Xem";ghost:true;enabled:!root.data.busy;clicked=>{root.action(132,index,""+image-index);}}
                                    if reference.kind=="sheet": Button {label:reference.approved ? "Bỏ duyệt" : "Duyệt bộ này";enabled:!root.data.busy;clicked=>{root.action(129,index,""+image-index);}}
                                    if reference.kind!="sheet": Button {label:reference.selected ? "Đang làm ảnh chuẩn" : "Dùng làm ảnh chuẩn";enabled:!root.data.busy && !reference.selected;clicked=>{root.action(128,index,""+image-index);}}
                                }
                            }
                        }
                        HorizontalLayout {spacing:4px;
                            Button {label:"Dùng ảnh cho cảnh";ghost:true;enabled:!root.data.busy && root.data.scenes.length>0 && root.data.character-images[index].path!="";clicked=>{root.action(82,index,"");}}
                            Button {label:"Xóa nhân vật";ghost:true;enabled:!root.data.busy;clicked=>{root.action(30,index,"");}}
                        }
                    }
                }
                if root.tab==1: DialogSection {
                    title:"Bối cảnh & phong cách chung";
                    Button {label:"AI tạo bối cảnh";enabled:root.data.ai-ready && !root.data.busy;clicked=>{root.action(43,0,"");}}
                    HorizontalLayout {spacing:4px;
                        Button {label:"+ Thêm bối cảnh";enabled:!root.data.busy;clicked=>{root.action(66,0,"");}}
                        Button {label:"Xóa bối cảnh";ghost:true;enabled:!root.data.busy && root.data.background-edit>0;clicked=>{root.action(68,0,"");}}
                    }
                    Select {options:root.data.backgrounds;current:root.data.background-edit;enabled:!root.data.busy;changed(index)=>{root.action(65,index,"");}}
                    ScriptEditor {height:100px;value:root.data.background-text;enabled:!root.data.busy && root.data.background-edit>0;edited(text)=>{root.action(67,0,text);}}
                    if root.data.background-image.path!="": Image {height:130px;source:root.data.background-image.preview;image-fit:contain;}
                    HorizontalLayout {spacing:4px;
