                    first:true;title:"Thư viện Video đã hoàn tất";
                    HorizontalLayout {
                        spacing:8px;
                        Text {text:root.data.files.length>0 ? "Có "+root.data.files.length+" video đã hoàn tất sẵn sàng dựng." : "Chưa có video đã tải cho cảnh này. Bấm '⚡ Tự động chạy toàn bộ kịch bản' ở bước Tạo video để bắt đầu.";color:Theme.fg-muted;font-size:Theme.fs-sm;horizontal-stretch:1;vertical-alignment:center;}
                        Button {label:"Làm mới kết quả";ghost:true;enabled:!root.data.busy;clicked=>{root.action(16,0,"");}}
                    }
                    for row[index] in root.data.scene-rows: HorizontalLayout {
                        spacing:6px;
                        Button {label:row.name;ghost:true;primary:root.data.scene==index;enabled:!root.data.busy;clicked=>{root.action(23,index,"");}}
                        Text {text:row.status;color:row.status=="completed" ? Theme.accent : Theme.fg-muted;font-size:Theme.fs-xs;vertical-alignment:center;horizontal-stretch:1;wrap:word-wrap;}
                    }
                    for file[index] in root.data.files: Rectangle {
                        background: Theme.field;
                        border-radius: Theme.r;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    width: 120px;
                                    height: 68px;
                                    background: Theme.well;
                                    border-radius: Theme.r;
                                    clip: true;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: file.preview;
                                        image-fit: contain;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: file.name;
                                        color: Theme.fg;
                                        font-size: Theme.fs;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: file.status != "" ? file.status : "Sẵn sàng đưa vào Timeline dựng";
                                        color: Theme.accent;
                                        font-size: Theme.fs-xs;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button { label: "👁️ Xem"; ghost: true; enabled: !root.data.busy; clicked => { root.action(114, index, ""); } }
                                Button { label: "✨ Xóa Logo"; ghost: true; enabled: !root.data.busy; clicked => { root.action(142, index, ""); } }
                                Button { label: "🚀 1080p"; ghost: true; enabled: !root.data.busy; clicked => { root.action(140, index, ""); } }
                                Button { label: "💎 2K"; ghost: true; enabled: !root.data.busy; clicked => { root.action(141, index, ""); } }
                                Button { label: "📂 Mở"; ghost: true; enabled: !root.data.busy; clicked => { root.action(15, index, ""); } }
                                Button { label: "📥 Nhập Timeline"; primary: true; enabled: root.data.can-import && !root.data.busy; clicked => { root.action(14, index, ""); } }
                            }
                        }
                    }
                    if !root.data.can-import: Text {text:"Mở một dự án Concat để nhập clip và dựng trên timeline.";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
                }
            }
        }
        HorizontalLayout {
            spacing:8px;
            Button {label:"← Quay lại";ghost:true;enabled:root.tab>0;clicked=>{root.tab=root.tab - 1;}}
            Rectangle {horizontal-stretch:1;}
            if root.tab<4: Button {label:"Tiếp: "+root.step-names[root.tab+1]+" →";primary:true;clicked=>{root.tab=root.tab+1;}}
        }
    }
    }
}
